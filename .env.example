# ============================================
# 资源聚合搜索服务配置
# 复制本文件为 .env 并按需填写（仅本地开发使用）。
# 部署到 Netlify 时，请在 Netlify 控制台
# Site settings -> Environment variables 里配置同名变量。
# 所有 key 均为可选 —— 不填也能用免费公共数据源。
# ============================================

# 服务端口
PORT=3000

# GitHub Token（可选，提高 GitHub API 限流：10次/分 -> 30次/分）
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Openverse Token（可选，提高图片素材接口限流）
# https://api.openverse.org/v1/auth_tokens/register/
OPENVERSE_TOKEN=

# Bing Web Search API Key（可选，提供更强的通用网页搜索兜底）
# https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_API_KEY=

# 单个数据源请求超时时间（毫秒）
PROVIDER_TIMEOUT_MS=8000
